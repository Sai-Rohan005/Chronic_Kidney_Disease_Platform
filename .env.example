# Copy to .env. Never commit populated values. Generate secrets as documented in README.md.
# Base64 of at least 32 random bytes, shared by all Java services and ML.
JWT_SECRET=
# Generate a hexadecimal password so it is safe in the Mongo connection URI.
MONGO_USERNAME=ckd
MONGO_PASSWORD=
MONGODB_DATABASE=CKD_JAVA
REDIS_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

AUTH_PORT=8081
APPOINTMENT_PORT=8082
REPORT_PORT=8083
PREDICTION_PORT=8084
ML_PORT=8001
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# Real model artifacts are mounted read-only; see docs/deployment.md for filenames.
ML_MODELS_PATH=./models
ML_PLATFORM=linux/amd64
PREDICTION_IMAGE_HOSTS=res.cloudinary.com
PREDICTION_TABULAR_WEIGHT=0.5
PREDICTION_IMAGE_WEIGHT=0.5
PREDICTION_THRESHOLD=0.5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Demo-only accounts. Provide distinct passwords of at least 12 characters.
DEMO_PATIENT_EMAIL=patient@demo.ckd.invalid
DEMO_DOCTOR_EMAIL=doctor@demo.ckd.invalid
DEMO_PATIENT_PASSWORD=
DEMO_DOCTOR_PASSWORD=
DEMO_APPOINTMENT_DATE=2030-01-15
# Optional real allowed HTTPS image. Set before first seed; existing appointments are preserved.
DEMO_ULTRASOUND_URL=
